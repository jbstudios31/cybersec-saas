# App
ENV=development
SECRET_KEY=change-me-in-production
CORS_ORIGINS=http://localhost:8000

# Database (Supabase example)
# Direct:   postgresql+psycopg2://postgres:<PASSWORD>@db.<PROJECT>.supabase.co:5432/postgres?sslmode=require
# Pooler:   postgresql+psycopg2://postgres.<PROJECT>:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_URL=postgresql+psycopg2://postgres:password@db.xxxxx.supabase.co:5432/postgres?sslmode=require

# Redis / Celery
REDIS_URL=redis://localhost:6379/0

# Modo escaneo
# SCAN_ASYNC=true  -> encola en Celery (requiere Redis + worker)
# SCAN_ASYNC=false -> ejecuta síncrono (free tier, sin worker). El request espera.
SCAN_ASYNC=true

# Cron externo (free tier, sin Celery beat)
# Token secreto que envía el cron en header X-Cron-Token (o Authorization: Bearer)
# Vacío = endpoint /cron/scan-next deshabilitado
CRON_TOKEN=

# Bootstrap admin (optional)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

# SMTP (optional)
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASS=
SMTP_USE_TLS=false
ALERT_EMAIL=alerts@localhost
ALERT_FROM_EMAIL=alerts@localhost
